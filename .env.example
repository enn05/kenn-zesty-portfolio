# Copy to .env.local and fill in. .env.local is gitignored.

# false -> read content from the Zesty stage/preview domain
# true  -> read from the production domain
PRODUCTION=false

# Password for the Zesty preview domain. Without it the preview endpoints
# return 401. The production domain ignores it, so it can be omitted when
# PRODUCTION=true. Find it in the Zesty manager under instance settings.
ZESTY_STAGE_PASSWORD=
